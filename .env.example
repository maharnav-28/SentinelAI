# SentinelAI Environment Configuration Template
# Copy this file to .env and insert your personal API keys if LLM synthesis is desired.
# The application runs smoothly in retrieval-only mode if no key is configured.

# LLM Provider: 'openai' or 'gemini'
LLM_PROVIDER=gemini

# Your LLM API Key (leave empty or unset to use SentinelAI in Retrieval-Only mode)
LLM_API_KEY=your_api_key_here

# Model name:
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
# For OpenAI: gpt-4o-mini or gpt-3.5-turbo
LLM_MODEL=gemini-1.5-flash

# Optional: custom base URL for OpenAI-compatible local/remote endpoints (e.g. Ollama, vLLM)
# LLM_BASE_URL=https://api.openai.com/v1
